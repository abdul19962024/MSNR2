# Telegram API credentials from my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_me

# Telethon StringSession generated once locally
TELEGRAM_SESSION_STRING=replace_me
TELEGRAM_CHANNEL=@YourChannel
TELEGRAM_ENABLED=true

TIMEZONE=Asia/Riyadh
LOOKBACK_HOURS=30
POLL_SECONDS=5
LIVE_POLL_SECONDS=3
LIVE_WINDOW_MINUTES=15
FULL_REFRESH_SECONDS=60
SIGNAL_MAX_AGE_MINUTES=2
FIXED_STOP_DOLLARS=4.0
EQUAL_TOLERANCE=0.10
PENDING_EXPIRY_HOURS=2
LEVEL_EXPIRY_HOURS=4
NO_NEW_FIRST_HOUR=true
NO_NEW_LAST_HOUR=true
SNB_DATA_DIR=/tmp/snb_gold_data
